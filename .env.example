# Nutrexia Environment Configuration Template

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://nutrexia_user:nutrexia_password@localhost:5432/nutrexia_db?schema=public"

# App Ports & URLs
PORT=4000
API_URL="http://localhost:4000"
NEXT_PUBLIC_STOREFRONT_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# Auth Secrets
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Razorpay Sandbox / Live Credentials
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Shiprocket Integration Credentials
SHIPROCKET_EMAIL="your_shiprocket_email@example.com"
SHIPROCKET_PASSWORD="your_shiprocket_password"

# Analytics Configuration
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_META_PIXEL_ID="000000000000000"

# Storage / S3 / Hostinger Uploads
STORAGE_ENDPOINT="https://your-s3-endpoint.com"
STORAGE_BUCKET="nutrexia-assets"
STORAGE_ACCESS_KEY="your_access_key"
STORAGE_SECRET_KEY="your_secret_key"
